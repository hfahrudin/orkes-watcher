# Copy to .env for local (non-Docker) development — e.g. `uv run uvicorn app.main:app --reload`
# against a Postgres/MinIO running some other way (docker run, a local install, etc).
#
# Running via the root docker-compose.yml doesn't need this file — the backend service's
# environment there is already set from the root .env (see .env.example there).

ORKES_DATABASE_URL=postgresql+asyncpg://orkes:orkes@localhost:5432/orkes
ORKES_MINIO_ENDPOINT=localhost:9000
ORKES_MINIO_ACCESS_KEY=orkes
ORKES_MINIO_SECRET_KEY=orkes12345
ORKES_MINIO_SECURE=false
ORKES_MINIO_BUCKET=orkes-traces

# First admin account, created automatically on first startup if no users exist.
ORKES_BOOTSTRAP_ADMIN_EMAIL=admin@orkes.local
ORKES_BOOTSTRAP_ADMIN_PASSWORD=changeme

# true once this sits behind real HTTPS — see app/config/settings.py's comment.
ORKES_COOKIE_SECURE=false
