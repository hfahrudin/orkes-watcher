# Copy to .env and adjust as needed. docker-compose reads .env automatically.

# Host port the dashboard is served on (container always listens on 80 internally).
FRONTEND_PORT=8080

# Host port the API is served on (container always listens on 8000 internally).
BACKEND_PORT=8000

# MinIO (S3-compatible) credentials — used by both the minio and backend services.
MINIO_ROOT_USER=orkes
MINIO_ROOT_PASSWORD=orkes12345

# Host ports for MinIO's S3 API and web console (container listens on 9000/9001 internally).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Host port for Adminer, a web-based Postgres client (container listens on 8080 internally).
ADMINER_PORT=8081

# First admin account, created automatically on first backend startup if no users exist.
BOOTSTRAP_ADMIN_EMAIL=admin@orkes.local
BOOTSTRAP_ADMIN_PASSWORD=changeme

# Set to true once this sits behind real HTTPS (a Secure cookie set over plain http:// is
# rejected or never sent back by most browsers, so keep this false for local/HTTP use).
COOKIE_SECURE=false
